{
  "type": "object",
  "required": [
    "assertion_type",
    "value",
    "status",
    "provenance"
  ],
  "properties": {
    "assertion_type": {
      "type": "string"
    },
    "value": {},
    "status": {
      "enum": [
        "published",
        "independent_observation",
        "project_derived"
      ]
    },
    "uncertainty": {
      "enum": [
        "certain",
        "probable",
        "possible",
        "uncertain",
        "unknown",
        "not_stated"
      ]
    },
    "physical_locus": {
      "type": [
        "string",
        "null"
      ]
    },
    "lineage_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "locator": {
            "type": [
              "string",
              "null"
            ]
          },
          "agent": {
            "type": [
              "string",
              "null"
            ]
          },
          "transformation": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_version": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scholarly assertion"
}
